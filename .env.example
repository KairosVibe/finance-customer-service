# ===== 金融智能客服 customer-service 配置示例（复制为 .env 后填写） =====

# LLM（OpenAI 兼容，示例为 DeepSeek）
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here

# 业务底座 finance-data
FINANCE_BASE_URL=http://127.0.0.1:8000
FINANCE_CHANNEL_CODE=MOBILE_BANK

# 数据库（customer_service 库，请按实际 MySQL 修改）
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/customer_service

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=8100

# dialoguekit 兼容字段（启动时同步到环境变量）
COMMERCE_API_BASE_URL=http://127.0.0.1:8000

# 本地 Embedding 模型路径（bge-m3，sentence-transformers 格式）
EMBEDDING_MODEL_PATH=D:/codebuddy/General-PurposeRAG/models/bge-m3

# finance-data 写接口使用的员工号（工单/挂失等）
FINANCE_OPERATOR_NO=EMP000001
